{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "apps/game/public/sprites/**"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-console": "off",
    "typescript/no-explicit-any": "off"
  }
}
