{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "apps/game/public/sprites/**",
    "apps/game/src/scripts/demos/**"
  ],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "vue",
    "import",
    "promise",
    "node"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-console": "off",
    "typescript/no-explicit-any": "off"
  }
}
