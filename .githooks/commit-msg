#!/bin/sh
# commit-msg：校验 Conventional Commits（本仓库提交历史的既有约定）。
# git 自动生成的消息（合并 / revert / fixup / squash）直接放行。
# 参数 $1 = 提交消息文件。git 在所有平台（含 Windows）用自带 sh 执行本脚本。
set -e

head_line=$(head -n 1 "$1")

case "$head_line" in
    "Merge "*|"Revert "*|"fixup! "*|"squash! "*)
        exit 0
        ;;
esac

# 形如 feat(api): xxx / fix(desktop,web): xxx / chore!: xxx
if printf '%s\n' "$head_line" | grep -qE \
    '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9]+(-[a-z0-9]+)*(,[a-z0-9]+(-[a-z0-9]+)*)*\))?(!)?: .+'; then
    exit 0
fi

echo "[commit-msg] 提交消息不符合 Conventional Commits：" >&2
echo "  $head_line" >&2
echo "期望形如：feat(api): 描述 / fix(desktop,web): 描述 / chore!: 描述" >&2
echo "类型：feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert" >&2
exit 1
